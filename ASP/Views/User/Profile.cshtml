@model ASP.Models.User.UserProfilePageModel
@{
    ViewData["Title"] = "Profile";
}

<div class="text-center">
    <h1 class="display-4">User's Profile</h1>
</div>

<div class="row">
    <div class="col col-xxl-6 offset-xxl-3      col-xl-8 offset-xl-2        col-md-10 offset-md-1">

        @if (Model.IsPersonal == null)
        {
            <div role="alert" class="alert alert-warning">No such profile exists or has been deleted</div>
        }
        else
        {
            <div class="row">
                <div class="col">Name</div>
                <div class="col" data-editable="Name">@Model.Name</div>
            </div>
            <div class="row">
                <div class="col">Member since</div>
                <div class="col">@Model.RegisteredAt</div>
            </div>
            <div class="row">
                <div class="col">Email</div>
                <div class="col"><span data-editable="Email">@Model.Email </span>*available only after signing in*</div>
            </div>
            if (Model.IsPersonal ?? false)
            {
                <div class="row">
                    <div class="col">Birthdate</div>
                    <div class="col">@Model.Birthdate</div>
                </div>
                <div class="row">
                    <div class="col"><button id="edit-profile-button" title="Edit personal details" class="btn btn-outline-dark"><i class="bi bi-pen"></i></button></div>
                    <div class="col"><button id="delete-profile-button" title="Delete profiled" class="btn btn-outline-danger"><i class="bi bi-trash3-fill"></i></button></div>
                </div>
                
            }
        }


    </div>
</div>
