@model ASP.Models.Shop.ShopAdminPageModel
@{
    ViewData["Title"] = "Shop";
    bool isAuthenticated = Context.User.Identity?.IsAuthenticated ?? false;
}
<div class="text-center">
    <h1 class="display-4">Manager's Workplace</h1>
</div>

@if (isAuthenticated)
{
    <form id="group-add-form" action="/api/product-group" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <div class="input-group">
                <span class="input-group-text" id="group-name-addon">Item group's name:</span>
                <input name="group-name" type="text" class="form-control" aria-describedby="group-name-addon group-name-subtitle">
            </div>
            <div class="form-text" id="group-name-subtitle">Enter item group's name to display on the website</div>
        </div>

        <div class="mb-3">
            <div class="input-group">
                <span class="input-group-text" id="group-description-addon">Description:</span>
                <input name="group-description" type="text" class="form-control" aria-describedby="group-description-addon group-description-subtitle">
            </div>
            <div class="form-text" id="group-description-subtitle">Enter detailed description</div>
        </div>

        <div class="mb-3">
            <div class="input-group">
                <span class="input-group-text" id="group-slug-addon">Slug:</span>
                <input name="group-slug" type="text" class="form-control" aria-describedby="group-slug-addon group-slug-subtitle">
            </div>
            <div class="form-text" id="group-slug-subtitle">Enter slug</div>
        </div>

        <div class="input-group mb-3">
            <label class="input-group-text" for="group-parent-id-addon">Parent group ID:</label>
            <select name="group-parent" class="form-select" id="group-parent-addon">
                @foreach (var option in Model.ProductGroups)
                {
                    <option value="@option.Value">@option.Content</option>
                }
            </select>
        </div>

        <div class="input-group mb-3">
            <label class="input-group-text" for="group-img">Group's image</label>
            <input name="group-image" type="file" class="form-control" id="group-img" />
        </div>

        <button type="submit" class="btn btn-success">Add group</button>

        <div id="group-form-success-alert" class="alert alert-success d-none m-3">Group created successfully</div>
        <div id="group-form-fail-alert" class="alert alert-danger d-none m-3"></div>
    </form>


    <form id="product-add-form" action="/api/product" method="post" enctype="multipart/form-data">

        <div class="mb-3">
            <div class="input-group">
                <span class="input-group-text" id="product-name-addon">Product's name:</span>
                <input name="product-name" type="text" class="form-control" aria-describedby="product-name-addon product-name-subtitle">
            </div>
            <div class="form-text" id="product-name-subtitle">Enter product's name to display on the website</div>
        </div>

        <div class="input-group mb-3">
            <label class="input-group-text" for="product-group-addon">Product group:</label>
            <select name="product-group" class="form-select" id="product-group-addon">
                @foreach(var option in Model.ProductGroups)
                {
                    <option value="@option.Value">@option.Content</option>
                }
            </select>
        </div>


        <div class="mb-3">
            <div class="input-group">
                <span class="input-group-text" id="product-description-addon">Description:</span>
                <input name="product-description" type="text" class="form-control" aria-describedby="product-description-addon product-description-subtitle">
            </div>
            <div class="form-text" id="product-description-subtitle">Enter detailed description</div>
        </div>

        <div class="mb-3">
            <div class="input-group">
                <span class="input-group-text" id="product-slug-addon">Slug:</span>
                <input name="product-slug" type="text" class="form-control" aria-describedby="product-slug-addon product-slug-subtitle">
            </div>
            <div class="form-text" id="product-slug-subtitle">Enter slug</div>
        </div>

        <div class="mb-3">
            <div class="input-group">
                <span class="input-group-text" id="product-price-addon">Price:</span>
                <input name="product-price" type="number" min="0" step="0.01" class="form-control" aria-describedby="product-price-addon product-price-subtitle">
            </div>
            <div class="form-text" id="product-price-subtitle">Enter price</div>
        </div>

        <div class="mb-3">
            <div class="input-group">
                <span class="input-group-text" id="product-stock-addon">Stock:</span>
                <input name="product-stock" type="number" min="0" step="1" class="form-control" aria-describedby="product-stock-addon product-stock-subtitle">
            </div>
            <div class="form-text" id="product-stock-subtitle">Enter number/amount to add</div>
        </div>

        <div class="input-group mb-3">
            <label class="input-group-text" for="product-img">Product's image</label>
            <input name="product-image" type="file" class="form-control" id="product-img" />
        </div>

        <button type="submit" class="btn btn-success">Add product</button>

        <div id="product-form-success-alert" class="alert alert-success d-none m-3">Product created successfully</div>
        <div id="product-form-fail-alert" class="alert alert-danger d-none m-3"></div>
    </form>
}
else
{
    <div class="alert alert-warning" role="alert">Manager's account is required to work with data</div>

}