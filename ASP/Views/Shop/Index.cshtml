@model ASP.Models.Shop.ShopIndexPageModel
@{
    ViewData["Title"] = "Shop";
    bool isAuthenticated = Context.User.Identity?.IsAuthenticated ?? false;
}

<div class="shop-logo"></div>

@if(isAuthenticated)
{
    <a asp-action="Admin">Manager's workplace</a>
}

@*  Display templates are ways of separating layout of a certain object (model). 
    One creates DisplayTemplates (name is important) directory in View directory (Views/Shop).
    Then one creates View itself. If name corresponds to the type name of the model then the choice 
    of template is automatic
    If the model type is complex (collection) or name is impossible, then template is declared directly @Html.FisplayFor(m => group, "Tepmlate name")*@

<div class="row row-cols-1 row-cols-md-3 row-cols-lg-5 g-4 mb-5 mt-2">
    @foreach(var group in Model.ProductGroups)
    {
        @Html.DisplayFor(m => group);
    }
</div>