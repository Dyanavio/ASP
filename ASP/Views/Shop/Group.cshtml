@model ASP.Models.Shop.ShopGroupPageModel
@{
	const int itemsPerSlide = 4;
}

@if(Model.ProductGroup == null)
{
	<div class="alert alert-dark" role="alert">Wow, such emptiness</div>
}
else
{
	<div class="d-flex justify-content-center">
		<div class="d-flex w-50 h-auto">
			<div id="carouselExample" class="carousel carousel-dark slide">
				<div class="carousel-inner">

					@for (int i = 0; i < Math.Ceiling((double)Model.ProductGroups.Count() / itemsPerSlide); i++)
					{
						<div class="carousel-item @(i == 0 ? "active" : "")">
							<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
								@for (int j = itemsPerSlide * i; j < (itemsPerSlide * i + itemsPerSlide > Model.ProductGroups.Count() ? Model.ProductGroups.Count() : itemsPerSlide * i + itemsPerSlide); j++)
								{
									@Html.DisplayFor(m => Model.ProductGroups.ToList()[j], "ProductGroupCarousel")
								}
							</div>
						</div>
					}


				</div>
				<button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
					<span aria-hidden="true"><i class="bi bi-arrow-left-circle-fill"></i></span>
					<span class="visually-hidden">Previous</span>
				</button>
				<button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
					<span aria-hidden="true"><i class="bi bi-arrow-right-circle-fill"></i></span>
					<span class="visually-hidden">Next</span>
				</button>
			</div>


		</div>
	</div>
	
	<div class="row row-cols-1 row-cols-md-3 row-cols-lg-5 g-4 mt-4">
		@foreach(var p in Model.ProductGroup.Products)
		{
			@Html.DisplayFor(m => p);
		}
	</div>
}
